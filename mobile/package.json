{
  "name": "tradevault-mobile",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "web:dev": "vite --config app/vite.config.ts",
    "web:build": "vite build --config app/vite.config.ts",
    "typecheck": "tsc -p app/tsconfig.json",
    "assets": "node scripts/prepare-assets.mjs && capacitor-assets generate --android",
    "sync": "capacitor sync android",
    "build:apk": "bash ./build-apk.sh",
    "open:android": "capacitor open android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "lightweight-charts": "4.2.3",
    "lucide-react": "0.469.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "@types/node": "^22.15.3",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "5.1.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.33",
    "sharp": "0.35.5",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "7.3.8"
  }
}
